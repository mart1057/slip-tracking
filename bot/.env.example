# Token จาก @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID ของคนที่ส่งสลิปได้ (คั่นด้วย , ถ้ามีหลายคน) ดู ID ได้โดยส่ง /id ให้ bot
ALLOWED_TELEGRAM_USER_IDS=

# ฐานข้อมูล Postgres ในเครื่อง (Homebrew ใช้ชื่อผู้ใช้ macOS และไม่มีรหัสผ่าน)
DATABASE_URL=postgres://localhost:5432/slip_tracker

# ที่เก็บรูปสลิป
SLIP_IMAGE_DIR=./data/slips

# สรุปที่ bot ส่งให้เอง (เวลาไทย รูปแบบ HH:MM) ใส่ off เพื่อปิด
DAILY_SUMMARY_TIME=20:00
WEEKLY_SUMMARY_DAY=sun
WEEKLY_SUMMARY_TIME=20:00

# API สำหรับ dashboard
API_HOST=127.0.0.1
API_PORT=4000
